meta {
  name: cr-bff-token
  type: http
  seq: 5
}

post {
  url: http://jwtlet.edc-v.svc.cluster.local:8080/token?Content-Type=application/x-www-form-urlencoded
  body: formUrlEncoded
  auth: inherit
}

params:query {
  Content-Type: application/x-www-form-urlencoded
}

body:json {
  {
    "grant_type": "urn:ietf:params:oauth:grant-type:token-exchange",
    --data-urlencode "subject_token=${CR_BFF_TOKEN}" \
    --data-urlencode "subject_token_type=urn:ietf:params:oauth:token-type:jwt" \
    --data-urlencode "resource=issuer" \
    --data-urlencode "scope=read" \
    --data-urlencode "audience=edcv"
  }
}

body:form-urlencoded {
  grant_type: urn:ietf:params:oauth:grant-type:token-exchange
  subject_token: {{CR_BFF_TOKEN}}
  subject_token_type: urn:ietf:params:oauth:token-type:jwt
  resource: issuer
  scope: read
  audience: edcv
}

