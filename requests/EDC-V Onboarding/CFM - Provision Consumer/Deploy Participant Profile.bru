meta {
  name: Deploy Participant Profile
  type: http
  seq: 4
}

post {
  url: {{tmBaseUrl}}/tenants/{{tenant_id}}/participant-profiles
  body: json
  auth: bearer
}

auth:bearer {
  token: eyJhbGciOiJFZERTQSIsImtpZCI6InNpZ25pbmctand0bGV0X3BjLTEiLCJ0eXAiOiJKV1QifQ..Z4wRw-XWnlsap1ChSVxoYUj4YTCpdu9NQxwW15JA2CLRxTHldASUFRHfdWaOomecL1-sCsyXibxMWn9oR3USAw
}

body:json {
  {
    "id": "{{$randomAlphaNumeric}}",
    "identifier": "{{participant_did}}-{{$randomUUID}}",
    "properties": {},
    "cellId": "{{cell_id}}",
    "version": 0,
    "vpaProperties": {
      "cfm.issuer": {
        "membership": "active",
        "membershipType": "full",
        "membershipStartDate": "2026-01-01T00:00:00Z",
        "id": "{{participant_did}}",
        "contractVersion": "1.0",
        "component_types": "electronics,sensors",
        "since": "2026-01-01T00:00:00Z"
      }
    },
    "participantRoles": {
      "{{dataspace_id}}": [
        "manufacturer"
      ]
    },
    "properties": {}
  }
}

vars:pre-request {
  cell_id: 12084a60-b787-4caa-b450-97b36d9f5b97
}

script:post-response {
  let body = res.getBody()
  test("Response contains id", function () {
      expect(body).to.have.property("id");
  });
  
  if (body && body.id) {
      bru.setVar("participant_profile_id", body.id);
  } 
}

